/*
 * Element harnessu testowego (F-01). maven-compiler-plugin 4.x czyta ten plik
 * i tłumaczy go na flagi JVM: łata produkcyjny module-info.class na czas testów,
 * bez modyfikowania src/main/java/module-info.java. Zależności testowe nie należą
 * do deskryptora produkcyjnego — stąd patch z zewnątrz zamiast wpisów w module-info.
 *
 * UWAGA przy dodawaniu testów: add-opens musi pokrywać KAŻDY pakiet, w którym leżą
 * klasy testowe. Bez wpisu JUnit nie sięgnie do klas refleksją i testy po prostu
 * znikną z raportu — bez błędu, bez ostrzeżenia. Objaw jest mylący, bo build jest
 * zielony; po prostu mniej testów niż powinno.
 */
patch-module hexatorn.mysmaug {
    // Biblioteki testowe (JUnit, AssertJ) trafiają na test-module-path jako moduły automatyczne.
    add-modules TEST-MODULE-PATH;
    add-reads TEST-MODULE-PATH;

    // Pakiet klas testowych otwarty na refleksję JUnita.
    add-opens hexatorn.mysmaug
           to org.junit.platform.commons;
}