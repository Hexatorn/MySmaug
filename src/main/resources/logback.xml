<?xml version="1.0" encoding="UTF-8"?>
<!--
  Konfiguracja logowania aplikacji. Logback znajduje ten plik autodetekcją — żaden literał
  w kodzie go nie wskazuje, więc ResourcesTest zgłosiłby go jako zasób osierocony. Zamiast
  wyjmować go spod ochrony strażnika, ma tam własną podłogę: jawną asercję, że istnieje.

  W testach NIE obowiązuje: logback-test.xml z src/test/resources ma pierwszeństwo.
-->
<configuration>

    <appender name="PLIK" class="ch.qos.logback.core.FileAppender">
        <!-- Ścieżka WZGLĘDNA — rozwiązuje się względem katalogu roboczego procesu. Przy
             `mvn javafx:run` to korzeń projektu. Dla app-image z jpackage katalog roboczy
             nie jest zagwarantowany; weryfikacja należy do F-04 (forward-nota w planie). -->
        <file>log/mysmaug.log</file>
        <!-- Dopisywanie między uruchomieniami: historia sprzed poprzednich sesji zostaje,
             a granice sesji (Faza 2) są jedyną nawigacją po takim pliku. -->
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <!-- Bez tego Logback pisze w domyślnym kodowaniu platformy — na polskim Windowsie
                 cp1250 — i polskie znaki w komunikatach rozsypują się na zapisie. -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Konsola aktywna zawsze. W developmencie to wygoda, a w spakowanej aplikacji konsoli
         nie ma, więc appender nic nie kosztuje. Plik pozostaje kanałem rozstrzygającym. -->
    <appender name="KONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="PLIK"/>
        <appender-ref ref="KONSOLA"/>
    </root>
</configuration>